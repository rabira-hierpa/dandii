// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  // Last time the user opened their My Submissions list. The account-drawer
  // avatar shows an unseen-count badge for proposals decided after this
  // (design-review D2). Null = never viewed.
  lastSubmissionsViewedAt DateTime?

  // Contributor rewards (R1). `points` is a cached sum of pointsLedger.delta;
  // the ledger is the source of truth. Level is derived from points in code.
  points       Int            @default(0)
  pointsLedger PointsLedger[]
  badges       UserBadge[]
  /// R2: appear on the public contributor leaderboard. Off by default —
  /// showing a real name publicly is the user's choice, never a side effect
  /// of contributing.
  leaderboardOptIn Boolean @default(false)

  /// Batch D: GTFS corrections this user made (audit trail for the editor).
  stopOverrides    StopOverride[]
  routeOverrides   RouteOverride[]
  stopOrderEdits   RouteStopOrderOverride[]
  tripEdits        TripOverride[]
  shapeEdits       ShapeOverride[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Transit domain — GTFS entities (ids are GTFS ids) + management tables
// ---------------------------------------------------------------------------

enum OperatorCode {
  ANBESSA
  SHEGER
  ALLIANCE
  MINIBUS
  LRT
}

/**
 * Where an entity came from. FEED rows are reloaded from the vendored DT4A feed
 * on every seed; OPERATOR rows were authored in the console and must survive it.
 * The seed's deletes are scoped to FEED for exactly this reason.
 */
enum EntityOrigin {
  FEED
  OPERATOR
}

enum FareKind {
  FLAT
  TIERED
}

enum ClosureReason {
  PUBLIC_HOLIDAY
  MAINTENANCE
  POLITICAL_EVENT
  OTHER
}

/**
 * How much of a route a closure takes out, and whether vehicles can pass.
 * SEVERED and SKIPPED carry the same data (a closed stop range) and differ only
 * in whether through-travel across that range is still possible.
 */
enum ClosureKind {
  WHOLE_ROUTE // entire route out of service (the historical behaviour)
  SEVERED // road blocked: nothing crosses, so the route is cut in two
  SKIPPED // vehicle detours: through-travel fine, listed stops not served
}

model Agency {
  id       String  @id
  name     String
  url      String?
  timezone String?
  routes   Route[]

  @@map("agency")
}

model Operator {
  id          String            @id @default(cuid())
  code        OperatorCode      @unique
  name        String
  kind        String // "Fixed-route bus" | "Light rail transit" | "Demand-responsive paratransit"
  assignments RouteAssignment[]

  @@map("operator")
}

model Route {
  id                String   @id
  shortName         String
  longName          String
  type              Int // GTFS route_type: 0 = LRT, 3 = bus
  color             String?
  textColor         String?
  agencyId          String
  agency            Agency   @relation(fields: [agencyId], references: [id])
  // The rider-facing geometry: full resolution for detail views, simplified for
  // the all-routes network layer. This is ONE direction (outbound) so the public
  // map draws a single legible line per route rather than a doubled corridor —
  // see Shape for the per-direction geometry the console needs.
  geojson           Json?
  geojsonSimplified Json?
  lengthMeters      Float?
  origin            EntityOrigin @default(FEED)

  trips         Trip[]
  fare          Fare?
  closures      RouteClosure[]
  assignment    RouteAssignment?
  proposals     FareProposal[]
  savedBy       SavedRoute[]
  fareChangeLog FareChangeLog[]

  @@index([shortName])
  @@map("route")
}

model Stop {
  id        String       @id
  name      String
  lat       Float
  lon       Float
  stopTimes StopTime[]
  origin    EntityOrigin @default(FEED)

  @@index([name])
  @@map("stop")
}

model Trip {
  id          String      @id
  routeId     String
  route       Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  serviceId   String
  shapeId     String?
  shape       Shape?      @relation(fields: [shapeId], references: [id])
  /// GTFS direction_id. Fully populated in the DT4A feed (447 direction-0 trips,
  /// 444 direction-1) and previously discarded by the seed. Names which of a
  /// route's two shapes is which, so riders can be shown one direction.
  directionId Int?
  headsign    String?
  stopTimes   StopTime[]
  frequencies Frequency[]

  @@index([routeId])
  @@index([shapeId])
  @@map("trip")
}

/**
 * One GTFS shape (a single drawn line), keyed by the feed's shape_id.
 *
 * Routes almost always have two: 444 of 447 in the DT4A feed run an outbound and
 * an inbound shape. The seed used to keep only the first and hang it on
 * `Route.geojson`, which meant the map drew one direction and discarded the
 * other for 99% of the network. Storing them per shape lets the public map show
 * one direction and the console show both.
 */
model Shape {
  id                String  @id
  geojson           Json
  geojsonSimplified Json
  lengthMeters      Float?
  trips             Trip[]

  @@map("shape")
}

model StopTime {
  tripId    String
  trip      Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stopId    String
  stop      Stop   @relation(fields: [stopId], references: [id], onDelete: Cascade)
  sequence  Int
  arrival   String?
  departure String?

  @@id([tripId, sequence])
  @@index([stopId])
  @@map("stop_time")
}

model Frequency {
  id          String @id @default(cuid())
  tripId      String
  trip        Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  startTime   String
  endTime     String
  headwaySecs Int

  @@index([tripId])
  @@map("frequency")
}

model Calendar {
  serviceId String  @id
  monday    Boolean
  tuesday   Boolean
  wednesday Boolean
  thursday  Boolean
  friday    Boolean
  saturday  Boolean
  sunday    Boolean
  startDate String
  endDate   String

  @@map("calendar")
}

model Fare {
  id            String     @id @default(cuid())
  routeId       String     @unique
  route         Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  kind          FareKind
  flatAmountEtb Decimal?   @db.Decimal(8, 2)
  currency      String     @default("ETB")
  tiers         FareTier[]
  updatedAt     DateTime   @updatedAt

  @@map("fare")
}

model FareTier {
  id        String  @id @default(cuid())
  fareId    String
  fare      Fare    @relation(fields: [fareId], references: [id], onDelete: Cascade)
  label     String // e.g. "0–4 km", "Short hop"
  fromKm    Float
  toKm      Float? // null = open-ended ("8+ km")
  amountEtb Decimal @db.Decimal(8, 2)

  @@index([fareId])
  @@map("fare_tier")
}

model RouteClosure {
  id          String        @id @default(cuid())
  routeId     String
  route       Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  reason      ClosureReason
  note        String?
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Partial closures. We store the CLOSED range rather than the open one: a
  // route has two trips with opposite stop order, and a closed range resolves
  // correctly against both, whereas "open up to X" needs a direction to mean
  // anything. Null on both = WHOLE_ROUTE (existing rows are untouched).
  kind       ClosureKind @default(WHOLE_ROUTE)
  /// First stop of the closed range, inclusive.
  fromStopId String?
  /// Last stop of the closed range, inclusive.
  toStopId   String?

  @@index([routeId, startsAt, endsAt])
  @@map("route_closure")
}

model RouteAssignment {
  id           String   @id @default(cuid())
  routeId      String   @unique
  route        Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  operatorId   String
  operator     Operator @relation(fields: [operatorId], references: [id])
  assignedById String? // null when assigned by the seed pipeline
  assignedAt   DateTime @default(now())

  @@index([operatorId])
  @@map("route_assignment")
}

// ---------------------------------------------------------------------------
// Operator edits to the vendored GTFS feed.
//
// We never mutate the seeded GTFS rows in place: a reseed would wipe the edit,
// and we'd lose the base-vs-edit distinction that lets an operator see what
// they changed. Instead each edit is an override row that survives reseed and
// is re-applied as the seed's final step. A null field means "not edited" and
// falls back to the base feed value, so an override row can carry one
// correction without freezing every other field.
//
// The GTFS export regenerates the edited tables from base + overrides rather
// than copying them verbatim (see docs/route-editor-design.md §3).
// ---------------------------------------------------------------------------

/// A stop-level correction. Today only the name; the DT4A feed has many
/// near-duplicate stop names ("Megenagna", "Megenagna Taxi") that operators
/// need to fix without touching geometry.
/// NOTE: `stopId` is deliberately NOT a foreign key to `stop`. The seed does a
/// full `stop.deleteMany()` before reloading the feed, so a cascading FK would
/// wipe every override on each reseed — the exact opposite of the point. The
/// override outlives the row it annotates and is re-applied afterwards; a
/// stopId that no longer exists in a newer feed is simply ignored on apply.
model StopOverride {
  stopId     String    @id
  name       String?
  /// Tombstone — see RouteOverride.deletedAt.
  deletedAt  DateTime?
  editedById String
  editedBy   User     @relation(fields: [editedById], references: [id])
  editedAt   DateTime @updatedAt

  @@map("stop_override")
}

/// A route-level correction: display names, map colors, and operator
/// reassignment (which drives the per-operator `agency_id` in the export).
/**
 * An operator-drawn route shape for one direction.
 *
 * `waypoints` is what the operator placed and what the editor reopens with;
 * `geojson` is the road-snapped line built from them. Both are stored on
 * purpose. Waypoints alone would mean re-snapping on every read — a live OTP
 * dependency for rendering, and a graph rebuild could silently redraw a shape
 * someone had already approved. Geometry alone would make the drawing
 * un-editable: reopening would offer ~130 snapped vertices instead of the
 * handful of decisions behind them.
 *
 * Same no-FK rule as [StopOverride]: the seed deletes and reloads every shape.
 */
model ShapeOverride {
  routeId     String
  directionId Int
  /// [{ lat, lon }] in order, as placed by the operator.
  waypoints   Json
  /// The snapped LineString actually drawn and exported.
  geojson     Json
  /// The feed's own geometry, captured on the FIRST edit only. Saving mirrors
  /// onto Shape.geojson in place, so without this "reset to feed shape" would
  /// have nothing to restore short of a full reseed. Null for rows written
  /// before this column existed.
  baseGeojson Json?
  editedById  String
  editedBy    User     @relation(fields: [editedById], references: [id])
  editedAt    DateTime @updatedAt

  @@id([routeId, directionId])
  @@map("shape_override")
}

/**
 * Per-trip corrections.
 *
 * `blockId` is GTFS block_id — which vehicle runs which trips back to back, so
 * a rider staying aboard between two "different" trips isn't told to alight and
 * reboard. The DT4A feed has no block_id column at all, so this is purely
 * operator knowledge, and emitting it means widening trips.txt on export.
 *
 * Same no-FK rule as [StopOverride]: the seed deletes and reloads every trip,
 * and a cascade here would erase the operator's work on each reseed.
 */
model TripOverride {
  tripId     String   @id
  blockId    String?
  headsign   String?
  editedById String
  editedBy   User     @relation(fields: [editedById], references: [id])
  editedAt   DateTime @updatedAt

  @@map("trip_override")
}

/**
 * An operator-reordered stop sequence for one direction of one route.
 *
 * Stored as the whole ordered list rather than a diff: a reorder is only
 * meaningful as a complete sequence, and replaying "move index 3 to 5" against
 * a feed whose stops changed underneath would corrupt the route silently.
 *
 * Applied to every trip in the direction. Times stay with the POSITION, not the
 * stop — a run reaches its 5th call at 06:20 whichever stop that is, and
 * carrying times along with stops would produce a non-monotonic timetable that
 * fails GTFS validation.
 *
 * Same no-FK rule as [StopOverride] so a reseed cannot cascade it away.
 */
model RouteStopOrderOverride {
  routeId     String
  directionId Int
  /// Ordered GTFS stop ids, first call to last.
  stopIds     String[]
  editedById  String
  editedBy    User     @relation(fields: [editedById], references: [id])
  editedAt    DateTime @updatedAt

  @@id([routeId, directionId])
  @@map("route_stop_order_override")
}

/// Same no-FK rule as [StopOverride]: routes are normally upserted by the seed,
/// but the fresh-reseed path does `route.deleteMany()`, and overrides must
/// survive that.
model RouteOverride {
  routeId      String        @id
  shortName    String?
  longName     String?
  color        String?
  textColor    String?
  operatorCode OperatorCode?
  /// GTFS route_desc / route_url. Empty across the whole Addis feed today —
  /// stored anyway because operators fill them in and they ship in the next
  /// generated feed version.
  desc         String?
  url          String?
  /// GTFS route_type, editable (base value lives on Route.type).
  type         Int?
  /// GTFS continuous_pickup / continuous_drop_off. Neither is a column in the
  /// base feed, so the exporter has to widen the header to emit them. Relevant
  /// here: Addis minibuses genuinely do board anywhere along the line.
  continuousPickup  Int?
  continuousDropOff Int?
  /// Tombstone. Deleting a FEED row outright is a lie — the next reseed brings
  /// it back — so deletion is recorded here and applied after the reload.
  deletedAt    DateTime?
  editedById   String
  editedBy     User          @relation(fields: [editedById], references: [id])
  editedAt     DateTime      @updatedAt

  @@map("route_override")
}

// ---------------------------------------------------------------------------
// Stop-graph analysis — a derived network graph (nodes = stops, edges = direct
// hops) used for centrality/interchange analysis. Rebuilt from a GTFS feed by
// an offline job; each run is a StopGraphBuild snapshot so results stay
// reproducible and comparable across feed versions.
// ---------------------------------------------------------------------------

enum StopGraphBuildStatus {
  READY
  FAILED
}

model StopGraphBuild {
  id            String               @id @default(cuid())
  builtAt       DateTime             @default(now())
  /// GTFS calendar window this graph was built for (YYYYMMDD).
  calendarStart String
  calendarEnd   String
  /// Feed the build read from, for traceability.
  sourcePath    String
  nodeCount     Int                  @default(0)
  edgeCount     Int                  @default(0)
  status        StopGraphBuildStatus @default(READY)
  error         String?

  nodes StopGraphNode[]
  edges StopGraphEdge[]

  @@map("stop_graph_build")
}

model StopGraphNode {
  id      String         @id @default(cuid())
  buildId String
  build   StopGraphBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  stopId  String
  /// Number of distinct stops reachable in one hop.
  degree  Int
  /// Betweenness centrality — how often this stop sits on shortest paths.
  betweenness Float @default(0)

  @@unique([buildId, stopId])
  @@index([buildId, betweenness])
  @@map("stop_graph_node")
}

model StopGraphEdge {
  id            String         @id @default(cuid())
  buildId       String
  build         StopGraphBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  fromStopId    String
  toStopId      String
  /// Median observed run time for this hop.
  travelTimeSec Float
  /// Trips per service day traversing this hop.
  frequency     Int

  @@unique([buildId, fromStopId, toStopId])
  @@index([buildId])
  @@index([fromStopId])
  @@index([toStopId])
  @@map("stop_graph_edge")
}

// ---------------------------------------------------------------------------
// Crowdsourced fare registry (design doc: rz-dev-design-20260721)
// ---------------------------------------------------------------------------

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  // Set on the other pending proposals for a route when one is approved, so
  // every reporter's My Submissions resolves and the queue converges (5A).
  SUPERSEDED
}

enum FareChangeSource {
  PROPOSAL_APPROVAL
  CONSOLE_EDIT
  RESEED
}

// A rider-submitted fare correction for a route. Whole-fare replacement,
// matching updateFare semantics. User ids are plain strings (no FK), like
// RouteClosure.createdById, so the audit trail survives user deletion (1A).
model FareProposal {
  id            String         @id @default(cuid())
  routeId       String
  route         Route          @relation(fields: [routeId], references: [id], onDelete: Cascade)
  submittedById String
  status        ProposalStatus @default(PENDING)
  note          String?

  // Proposed fare (whole-fare replacement).
  proposedKind    FareKind
  proposedFlatEtb Decimal? @db.Decimal(8, 2)
  proposedTiers   Json? // [{label, fromKm, toKm, amountEtb}] when TIERED

  // Snapshot of the fare at submission time, for stable diffs. Nullable: a
  // route may have no Fare row yet ("no fare on record").
  baselineKind    FareKind?
  baselineFlatEtb Decimal? @db.Decimal(8, 2)
  baselineTiers   Json?

  reviewedById String?
  reviewNote   String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([routeId, status])
  @@index([submittedById, createdAt])
  @@map("fare_proposal")
}

model SavedRoute {
  userId    String
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, routeId])
  @@index([userId])
  @@map("saved_route")
}

// Append-only audit trail: one row per fare write from any source.
model FareChangeLog {
  id          String           @id @default(cuid())
  routeId     String
  route       Route            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  proposalId  String?
  changedById String
  source      FareChangeSource

  beforeKind    FareKind?
  beforeFlatEtb Decimal?  @db.Decimal(8, 2)
  beforeTiers   Json?
  afterKind     FareKind?
  afterFlatEtb  Decimal?  @db.Decimal(8, 2)
  afterTiers    Json?

  createdAt DateTime @default(now())

  @@index([routeId, createdAt])
  @@map("fare_change_log")
}

enum ValidatorStatus {
  PENDING
  PASS
  WARN
  FAIL
}

// A generated, versioned GTFS export (fares overlay on the base feed).
model FeedVersion {
  id              String          @id @default(cuid())
  version         Int             @unique
  label           String
  filePath        String
  sizeBytes       Int
  fareChangeCount Int             @default(0)
  generatedById   String
  validatorStatus ValidatorStatus @default(PENDING)
  validatorReport Json?
  // Cursor: the newest FareChangeLog id included in this version. The next
  // version's change report lists entries created after this (no time races).
  lastChangeLogId String?
  createdAt       DateTime        @default(now())

  @@map("feed_version")
}

// ---------------------------------------------------------------------------
// Contributor rewards (R1) — see docs/rewards-and-amharic-design.md
// ---------------------------------------------------------------------------

enum PointsReason {
  SUBMIT // rider submitted a fare proposal (+2 nod)
  APPROVED // proposal approved (+20, the real reward)
  REJECT_CLAWBACK // proposal rejected — remove the submit nod (-2)
  SUPERSEDED_CREDIT // a correct sibling landed first (+10 partial credit)
  BADGE_BONUS // one-off bonus when a badge is earned
  BACKFILL // retroactive award for pre-R1 approved proposals
}

// Append-only ledger of every point change. `User.points` is the cached sum.
// The (proposalId, reason) uniqueness makes awards idempotent — a double-fire
// (retry, concurrent decision) can never double-pay for the same event.
model PointsLedger {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta      Int
  reason     PointsReason
  proposalId String?
  createdAt  DateTime     @default(now())

  @@unique([proposalId, reason])
  @@index([userId, createdAt])
  @@map("points_ledger")
}

// A milestone badge a user has earned. Event-based (stored, not derived) so we
// can show when it was earned and celebrate it once.
model UserBadge {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    String // "first_fix" | "reliable_reporter" | "fare_authority"
  earnedAt DateTime @default(now())

  @@id([userId, badge])
  @@index([userId])
  @@map("user_badge")
}
